{
  "name": "codeskope",
  "version": "1.0.0",
  "description": "A TypeScript code-intelligence graph for imports, calls, queries, and impact analysis",
  "repository": {
    "type": "git",
    "url": "https://github.com/RuchiPurohit/codeskope.git"
  },
  "homepage": "https://github.com/RuchiPurohit/codeskope#readme",
  "bugs": {
    "url": "https://github.com/RuchiPurohit/codeskope/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "bin": {
    "codeskope": "./dist/cli.js",
    "codeskope-mcp": "./dist/mcp/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "codeskope": "node --import tsx src/cli.ts",
    "codeskope-mcp": "node --import tsx src/mcp/stdio.ts",
    "example": "node --import tsx examples/basic.ts",
    "inspect-ast": "node --import tsx examples/inspectAst.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "typescript": "^5.9.0",
    "zod": "^4.6.7"
  }
}
